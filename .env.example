PORT=3000
NODE_ENV=development
BASE_URL=https://your-homeserver-domain.com

# HighLevel App Credentials
GHL_CLIENT_ID=your_ghl_client_id
GHL_CLIENT_SECRET=your_ghl_client_secret
GHL_SCOPES=contacts.readonly contacts.write conversations.readonly conversations.write conversations/message.readonly conversations/message.write
GHL_REDIRECT_URI=https://your-homeserver-domain.com/api/oauth/highlevel/callback
GHL_CONVERSATION_PROVIDER_ID=6ac0bbc0e2328b5346d36789

# LINE OA Credentials
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/line_ghl_poc?schema=public
